{
  "id": "herd",
  "title": "Herd Mentality • უმრავლესობა",
  "questions": [
    {
      "id": "herd_0001",
      "text": "დაასახელე ხილი, რომელსაც ყველაზე ხშირად ყიდულობენ."
    },
    {
      "id": "herd_0002",
      "text": "დაასახელე საჭმელი, რომელსაც ხელით ჭამენ."
    },
    {
      "id": "herd_0003",
      "text": "დაასახელე ცხოველი, რომელიც კარგი შინაური მეგობარია."
    },
    {
      "id": "herd_0004",
      "text": "დაასახელე ფერი, რომელსაც ზაფხულს უკავშირებ."
    },
    {
      "id": "herd_0005",
      "text": "დაასახელე ნივთი, რომელიც პლაჟზე მიგაქვს."
    },
    {
      "id": "herd_0006",
      "text": "დაასახელე საუზმის საჭმელი."
    },
    {
      "id": "herd_0007",
      "text": "დაასახელე წვიმიანი დღის გასართობი."
    },
    {
      "id": "herd_0008",
      "text": "დაასახელე ყველაზე პოპულარული პიცის ინგრედიენტი."
    },
    {
      "id": "herd_0009",
      "text": "დაასახელე სასმელი, რომელსაც დილით სვამენ."
    },
    {
      "id": "herd_0010",
      "text": "დაასახელე ნივთი, რომელსაც სახლიდან გასვლისას ამოწმებ."
    },
    {
      "id": "herd_0011",
      "text": "დაასახელე სპორტი, რომელსაც ბურთით თამაშობენ."
    },
    {
      "id": "herd_0012",
      "text": "დაასახელე ცხოველი, რომელსაც ზოოპარკში ელოდები."
    },
    {
      "id": "herd_0013",
      "text": "დაასახელე დაბადების დღის საჩუქარი."
    },
    {
      "id": "herd_0014",
      "text": "დაასახელე საჭმელი, რომელიც ქართულ სუფრას გახსენებს."
    },
    {
      "id": "herd_0015",
      "text": "დაასახელე დესერტი, რომელსაც რესტორანში შეუკვეთავდი."
    },
    {
      "id": "herd_0016",
      "text": "დაასახელე ნივთი, რომელიც სამზარეულოშია."
    },
    {
      "id": "herd_0017",
      "text": "დაასახელე ადგილი, სადაც პაემანზე მიდიან."
    },
    {
      "id": "herd_0018",
      "text": "დაასახელე პროფესია, რომელზეც ბავშვები ოცნებობენ."
    },
    {
      "id": "herd_0019",
      "text": "დაასახელე რამე, რაც ძალიან ხმაურობს."
    },
    {
      "id": "herd_0020",
      "text": "დაასახელე რამე, რაც ძალიან ცივია."
    },
    {
      "id": "herd_0021",
      "text": "დაასახელე ყვავილი, რომელსაც ჩუქნიან."
    },
    {
      "id": "herd_0022",
      "text": "დაასახელე ტრანსპორტი, რომლითაც სამსახურში მიდიან."
    },
    {
      "id": "herd_0023",
      "text": "დაასახელე ქალაქი, რომლის ნახვაც ტურისტებს უნდათ."
    },
    {
      "id": "herd_0024",
      "text": "დაასახელე ნივთი, რომელიც მოგზაურობისას ხშირად ავიწყდებათ."
    },
    {
      "id": "herd_0025",
      "text": "დაასახელე საკვები, რომელიც კინოში მიგაქვს."
    },
    {
      "id": "herd_0026",
      "text": "დაასახელე მუსიკალური ინსტრუმენტი."
    },
    {
      "id": "herd_0027",
      "text": "დაასახელე საგანი, რომელიც სკოლას გახსენებს."
    },
    {
      "id": "herd_0028",
      "text": "დაასახელე ცხოველი, რომელიც ნელა მოძრაობს."
    },
    {
      "id": "herd_0029",
      "text": "დაასახელე რამე, რასაც მაცივარში ინახავენ."
    },
    {
      "id": "herd_0030",
      "text": "დაასახელე ნივთი, რომელიც ზამთარში გჭირდება."
    },
    {
      "id": "herd_0031",
      "text": "დაასახელე რამე, რასაც ახალ წელს აკეთებენ."
    },
    {
      "id": "herd_0032",
      "text": "დაასახელე ადგილი, სადაც რიგში დგომა გიწევს."
    },
    {
      "id": "herd_0033",
      "text": "დაასახელე სოუსი, რომელსაც კარტოფილს აყოლებენ."
    },
    {
      "id": "herd_0034",
      "text": "დაასახელე ნივთი, რომელიც მაგიდაზე დევს."
    },
    {
      "id": "herd_0035",
      "text": "დაასახელე ცხოველი, რომელიც სწრაფად დარბის."
    },
    {
      "id": "herd_0036",
      "text": "დაასახელე რამე, რასაც დაბადების დღეზე ჭამენ."
    },
    {
      "id": "herd_0037",
      "text": "დაასახელე ადგილი, სადაც სიმშვიდეს ეძებ."
    },
    {
      "id": "herd_0038",
      "text": "დაასახელე ტანსაცმელი, რომელსაც სახლში ატარებ."
    },
    {
      "id": "herd_0039",
      "text": "დაასახელე რამე, რაც ცაში დაფრინავს."
    },
    {
      "id": "herd_0040",
      "text": "დაასახელე საჭმელი, რომელსაც შეკვეთით სახლში მოატანინებდი."
    }
  ]
}
