{
  "id": "noyesno",
  "title": "აკრძალული პასუხი",
  "questions": [
    { "id": "nyn-001", "text": "შეგიძლია მთელი დღე ტელეფონის გარეშე გაძლო?" },
    { "id": "nyn-002", "text": "ოდესმე მაცივარი უმიზეზოდ გაგიღია?" },
    { "id": "nyn-003", "text": "შენი მაღვიძარას ხმას მეგობრები გაუძლებდნენ?" },
    { "id": "nyn-004", "text": "ბოლო ნაჭერ პიცას სხვას დაუტოვებდი?" },
    { "id": "nyn-005", "text": "ამ ოთახში ყველაზე პუნქტუალური შენ ხარ?" },
    { "id": "nyn-006", "text": "შეგიძლია საკუთარი სიცილი აღწერო?" },
    { "id": "nyn-007", "text": "როცა ამბობ, ხუთ წუთში მოვალო, მართლა ხუთ წუთს გულისხმობ?" },
    { "id": "nyn-008", "text": "შენი ბავშვობის ვარცხნილობა ისევ მოგიხდებოდა?" },
    { "id": "nyn-009", "text": "შენს კატას ან ძაღლს შენზე მეტი მეგობარი ეყოლებოდა?" },
    { "id": "nyn-010", "text": "ანანასი პიცაზე მოგწონს?" },
    { "id": "nyn-011", "text": "სარკის წინ კონცერტი ჩაგიტარებია?" },
    { "id": "nyn-012", "text": "სასაცილო ვიდეოზე მარტო ყოფნისასაც ხმამაღლა იცინი?" },
    { "id": "nyn-013", "text": "ხვალ დილით ექვსზე სასეირნოდ წამომყვებოდი?" },
    { "id": "nyn-014", "text": "ლიფტში უცხო ადამიანს საუბარს დაუწყებდი?" },
    { "id": "nyn-015", "text": "ყველა შენი პაროლი ზეპირად გახსოვს?" },
    { "id": "nyn-016", "text": "გიფიქრია, რომ რეალითი შოუში გაიმარჯვებდი?" },
    { "id": "nyn-017", "text": "საკუთარ დაბადების დღეზე სიურპრიზი გაგიხარდებოდა?" },
    { "id": "nyn-018", "text": "ბავშვობაში გჯეროდა, რომ მთვარე მოგყვებოდა?" },
    { "id": "nyn-019", "text": "სიმღერის უცნობ სიტყვებს თვითონ იგონებ?" },
    { "id": "nyn-020", "text": "შეგიძლია საყვარელ კერძზე ერთი თვით უარი თქვა?" },
    { "id": "nyn-021", "text": "შენს ტელეფონში ათზე მეტი სელფია?" },
    { "id": "nyn-022", "text": "სიცილის შეკავება სერიოზულ შეხვედრაზე მოგიწია?" },
    { "id": "nyn-023", "text": "ერთი და იგივე ფილმს მესამედ უყურებდი?" },
    { "id": "nyn-024", "text": "მეგობარს შენი ტანსაცმლის არჩევას მიანდობდი?" },
    { "id": "nyn-025", "text": "შეძლებდი ერთი კვირა მხოლოდ ჩურჩულით გელაპარაკა?" },
    { "id": "nyn-026", "text": "კოსმოსში წასვლის უფასო ბილეთს გამოიყენებდი?" },
    { "id": "nyn-027", "text": "ხანდახან შეტყობინებას წერ და ბოლოს მთლიანად შლი?" },
    { "id": "nyn-028", "text": "დაკარგულ ნივთს იქ ეძებ, სადაც უკვე სამჯერ მოძებნე?" },
    { "id": "nyn-029", "text": "შენი სახელი მოგწონს?" },
    { "id": "nyn-030", "text": "შეგიძლია ათი წუთი გაუნძრევლად იჯდე?" },
    { "id": "nyn-031", "text": "საყიდლებზე სიის გარეშე წასვლა კარგი აზრია?" },
    { "id": "nyn-032", "text": "ოდესმე უცხოს მისალმებიხარ, რადგან მეგობარში აგერია?" },
    { "id": "nyn-033", "text": "კარაოკეზე პირველ სიმღერას შენ აირჩევდი?" },
    { "id": "nyn-034", "text": "წვიმაში სეირნობა მოგწონს?" },
    { "id": "nyn-035", "text": "შენი ჩანთიდან ახლა რაიმე მოულოდნელი ნივთი ამოვიდოდა?" },
    { "id": "nyn-036", "text": "ერთი დღით მეგობარს სამსახურში ჩაანაცვლებდი?" },
    { "id": "nyn-037", "text": "დესერტისთვის ადგილი ყოველთვის გრჩება?" },
    { "id": "nyn-038", "text": "შეგიძლია შენი საყვარელი ემოჯი სახით აჩვენო?" },
    { "id": "nyn-039", "text": "ფილმის დასასრულის წინასწარ გაგება გაბრაზებს?" },
    { "id": "nyn-040", "text": "ტელეფონი ხელში გჭერია და მაინც გიძებნია?" },
    { "id": "nyn-041", "text": "ამ თამაშის მოგებას გეგმავ?" },
    { "id": "nyn-042", "text": "ყველა კითხვაზე გულწრფელად პასუხობ?" },
    { "id": "nyn-043", "text": "ახლა აკრძალული სიტყვის თქმა მოგინდა?" },
    { "id": "nyn-044", "text": "დარწმუნებული ხარ, რომ დრო ჯერ არ გასულა?" },
    { "id": "nyn-045", "text": "შეგიძლია ამ კითხვას სხვა კითხვით უპასუხო?" },
    { "id": "nyn-046", "text": "მეგობრები შენს რჩევებს ხშირად ითვალისწინებენ?" },
    { "id": "nyn-047", "text": "შენი საყვარელი საჭმელი საუზმეზეც მოგინდებოდა?" },
    { "id": "nyn-048", "text": "ოდესმე მაღვიძარა ხუთჯერ მაინც გადაგიდია?" },
    { "id": "nyn-049", "text": "ერთხელ მაინც ავტობუსის გაჩერება გამოგრჩენია?" },
    { "id": "nyn-050", "text": "მთელი დღე სიმღერით საუბარს გაბედავდი?" }
